# Copie este arquivo para .env.local e preencha. NUNCA comite o .env.local com valores reais.
# Última atualização: 14/08/2026

# ===== Supabase (essencial) =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-anon
# Chave de serviço (admin) usada SÓ no servidor (rotas em src/app/api). Nunca exponha no cliente.
SUPABASE_SERVICE_KEY=chave-de-servico

# ===== Acesso / superadmins (opcional) =====
# Código exigido no cadastro (rota /api/cadastro), se quiser travar o autocadastro.
CODIGO_ACESSO=
# Lista de e-mails superadmin separados por vírgula (enxergam tudo).
SUPER_ADMINS=
NEXT_PUBLIC_SUPER_ADMINS=

# ===== Web Push / notificações (opcional) =====
# Em produção estas chaves VAPID ficam na tabela app_kv do banco (não aqui).
# Para gerar localmente: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com
# Segredo que protege o endpoint de envio diário (/api/push/enviar), chamado por cron.
CRON_SECRET=
