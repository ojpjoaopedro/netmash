# Copie este arquivo para .env.local e preencha. NUNCA comite o .env.local com valores reais.
# Última atualização: 14/08/2026

# ===== Supabase (essencial) =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-anon
# Chave de serviço (admin) usada SÓ no servidor (rotas em src/app/api). Nunca exponha no cliente.
SUPABASE_SERVICE_KEY=chave-de-servico

# ===== Acesso / superadmins (opcional) =====
# Código exigido no cadastro (rota /api/cadastro), se quiser travar o autocadastro.
CODIGO_ACESSO=
# Lista de e-mails superadmin separados por vírgula (enxergam tudo).
SUPER_ADMINS=
NEXT_PUBLIC_SUPER_ADMINS=

# ===== Pagamentos / checkout (Wiven) =====
# Os PREÇOS vêm dos produtos cadastrados na Wiven: o app lê o valor da página do
# link de checkout de cada produto (o link fica no Admin > Produtos). Não há nada
# de preço para configurar aqui.
#
# Chaves da API (painel da Wiven > API > Gerar credenciais), opcionais: servem
# para conferir a transação quando o webhook chega e para criar checkout pela API
# em produto sem link. Em produção podem ficar na tabela app_kv, chaves
# 'wiven_public_key' e 'wiven_secret_key'.
WIVEN_PUBLIC_KEY=
WIVEN_SECRET_KEY=
# Token que você cadastra no webhook dentro da Wiven (Configurações > Webhooks,
# URL https://SEU-DOMINIO/api/webhooks/wiven). Sem ele o app recusa os avisos.
# Também aceita ficar em app_kv, chave 'wiven_webhook_token'.
WIVEN_WEBHOOK_TOKEN=
# Chave que cifra a senha escolhida na landing até o pagamento ser confirmado.
# Use uma frase longa e aleatória. Em app_kv: chave 'checkout_secret'.
CHECKOUT_SECRET=
# Endereço público do site (usado no retorno do checkout e nos e-mails).
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br
# Só afeta o checkout criado pela API (produto sem link cadastrado): a oferta vai
# em centavos, que é o padrão da Wiven. Mude para 0 se a sua conta usar reais.
# WIVEN_PRECO_CENTAVOS=1

# ===== Web Push / notificações (opcional) =====
# Em produção estas chaves VAPID ficam na tabela app_kv do banco (não aqui).
# Para gerar localmente: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@seudominio.com
# Segredo que protege o endpoint de envio diário (/api/push/enviar), chamado por cron.
CRON_SECRET=
